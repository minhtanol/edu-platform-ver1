POSTGRES_DB=education
POSTGRES_USER=education
POSTGRES_PASSWORD=change-this-postgres-password
JWT_SECRET=change-this-jwt-secret-at-least-48-random-characters
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14
ADMIN_INITIAL_PASSWORD=change-this-admin-password
CORS_ORIGINS=https://your-domain.com,http://your-ec2-public-ip
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
STORAGE_PROVIDER=r2
CLOUDFLARE_R2_ACCOUNT_ID=<account-id>
CLOUDFLARE_R2_ACCESS_KEY=<r2-access-key>
CLOUDFLARE_R2_SECRET_KEY=<r2-secret-key>
CLOUDFLARE_R2_BUCKET_NAME=<bucket-name>
CLOUDFLARE_R2_PUBLIC_URL=https://<public-r2-domain>
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_REGION=auto
UPLOAD_DIR=/app/uploads
MEDIA_CLEANUP_CRON=0 30 2 * * *
MEDIA_CLEANUP_ZONE=Asia/Bangkok
VITE_API_URL=/api/v1
